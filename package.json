{
  "name": "dipen-personal-site",
  "version": "0.1.0",
  "private": true,
  "description": "Personal website inside a 1:1 iPod Classic interface",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --tsconfig tsconfig.scripts.json scripts/migrate.ts",
    "seed": "tsx --tsconfig tsconfig.scripts.json scripts/seed.ts",
    "seed:force": "tsx --tsconfig tsconfig.scripts.json scripts/seed.ts --force",
    "import:ugg": "tsx --tsconfig tsconfig.scripts.json scripts/import-ugg.ts",
    "import:ugg:instagram": "tsx --tsconfig tsconfig.scripts.json scripts/import-ugg-instagram.ts",
    "import:spotify": "tsx --tsconfig tsconfig.scripts.json scripts/import-spotify.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "media:ingest": "tsx --tsconfig tsconfig.scripts.json scripts/media/ingest-images.ts",
    "media:check": "tsx --tsconfig tsconfig.scripts.json scripts/media/check.ts",
    "content:recipe": "tsx --tsconfig tsconfig.scripts.json scripts/content/new-recipe.ts",
    "content:article": "tsx --tsconfig tsconfig.scripts.json scripts/content/new-article.ts",
    "content:tweets": "tsx --tsconfig tsconfig.scripts.json scripts/content/add-tweets.ts",
    "media:posters": "tsx --tsconfig tsconfig.scripts.json scripts/media/video-posters.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.45.2",
    "exif-reader": "^2.0.3",
    "fast-xml-parser": "^4.5.3",
    "next": "^15.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^4.5.0",
    "drizzle-kit": "^0.31.1",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
