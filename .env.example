# Copy to .env for local overrides. Never commit real values.

# SQLite database file. Docker/Fly: /data/site.db (set in Dockerfile / fly.toml).
# DATABASE_PATH=./data/site.db

# Root of the media tree (images + videos), kept outside the repo.
# Local default: ./media. Docker/Fly: /data/media on the volume.
# MEDIA_DIR=./media

# Legacy override for the UGG Chronicles videos; defaults to $MEDIA_DIR/videos/ugg.
# VIDEOS_DIR=./media/videos/ugg

# Apex domain. When set, ipod.<domain> / itunes.<domain> serve the device
# views and the apex /ipod, /itunes paths redirect to them. Unset = path mode
# (fly.dev, CI). In development it defaults to "localhost" so ipod.localhost:3000 works.
# SITE_DOMAIN=dipengupta.com
